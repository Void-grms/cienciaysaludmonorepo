{
  "name": "lis-monorepo",
  "version": "1.0.0",
  "description": "LIS System Monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=backend",
    "dev:admin": "npm run dev --workspace=frontend/portal-admin",
    "dev:paciente": "npm run dev --workspace=frontend/portal-paciente",
    "dev:referencia": "npm run dev --workspace=frontend/portal-referencia",
    "dev": "npm run dev:api & npm run dev:admin & npm run dev:paciente & npm run dev:referencia"
  }
}
